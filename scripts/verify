#!/bin/bash
# Pre-commit verification gate.
#
# Checks:
#   cargo clippy  -- warnings as errors (correctness, idiomatic Rust, clarity)
#   cargo build   -- bare-metal build succeeds
#   cargo test    -- all host tests pass
#   unsafe count  -- inventory, split by frame/ boundary
#   framekernel   -- no unsafe outside frame/ (belt-and-suspenders with lint)
#
# Not automated (design judgment, enforced by CLAUDE.md guidelines):
#   performance, FP style, Verus readiness
#
# Install as git pre-commit hook:
#   ln -sf ../../scripts/verify .git/hooks/pre-commit

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
DIM='\033[2m'
RESET='\033[0m'

pass() { printf "${GREEN}pass${RESET}  %s\n" "$1"; }
fail() { printf "${RED}FAIL${RESET}  %s\n" "$1"; exit 1; }
info() { printf "${DIM}info${RESET}  %s\n" "$1"; }

# b, c, g: Clippy with warnings-as-errors.
# -A dead_code: spec-placeholder structs (observer.rs, time.rs) have fields
# that aren't used in code yet. Tracked, not a real issue.
cargo clippy -- -D warnings -A dead_code 2>&1 | tail -1
pass "clippy clean"

# b: Bare-metal build must succeed.
cargo build 2>/dev/null
pass "bare-metal build"

# e: All host tests must pass.
TEST_OUTPUT=$(cargo test --target aarch64-apple-darwin 2>&1)
TEST_LINE=$(echo "$TEST_OUTPUT" | grep "^test result:" | head -1)
pass "tests: $TEST_LINE"

# f: Framekernel discipline — all unsafe confined to frame/.
# The crate-level #![deny(unsafe_code)] with #[allow(unsafe_code)] on mod frame
# enforces this at compile time. This check is belt-and-suspenders visibility.
UNSAFE_IN_FRAME=$(grep -r 'unsafe {' src/frame/ --include='*.rs' 2>/dev/null | wc -l | tr -d ' ')
UNSAFE_TOTAL=$(grep -r 'unsafe {' src/ --include='*.rs' 2>/dev/null | wc -l | tr -d ' ')
UNSAFE_OUTSIDE=$((UNSAFE_TOTAL - UNSAFE_IN_FRAME))
info "unsafe blocks: $UNSAFE_IN_FRAME in frame/, $UNSAFE_OUTSIDE outside"

if [ "$UNSAFE_OUTSIDE" -gt 0 ]; then
    echo ""
    grep -rn 'unsafe {' src/ --include='*.rs' | grep -v 'src/frame/' || true
    fail "framekernel violation: unsafe block outside frame/"
fi
pass "framekernel boundary (all unsafe in frame/)"
