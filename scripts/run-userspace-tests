#!/bin/bash
# Userspace test runner for EL0 test binaries.
#
# Builds the kernel, assembles each .S file in tests/userspace/ into a flat
# binary, runs it on the kernel via the hypervisor, and checks serial output
# for pass/fail markers.
#
# ── Test binary protocol ──────────────────────────────────────────────
#
# Entry: binary is loaded at USER_CODE_VA (0x4000). Entry point is offset 0.
#        SP is set to USER_STACK_TOP (0xC000). pstate = EL0t.
#
# Pass:  BRK #0x42 — kernel prints "TEST PASSED" and exits via PSCI
#        SYSTEM_OFF. The hypervisor exits with code 0.
#
# Fail:  BRK #N (N != 0x42) — kernel prints "FATAL FAULT" and exits via
#        PSCI SYSTEM_OFF. The hypervisor exits with code 0.
#        Timeout — the hypervisor exits with code 2 after --timeout seconds.
#        Panic — kernel prints "panic:" and the hypervisor exits with code 1.
#
# Naming: files starting with "fail_" are expected to fail (FATAL FAULT).
#         All other .S files are expected to pass (TEST PASSED).
#
# ── Toolchain ─────────────────────────────────────────────────────────
#
# Assembler: /usr/bin/clang --target=aarch64-unknown-none
# Linker:    ~/.cargo/bin/rust-lld -flavor gnu --oformat binary
# Runner:    ~/.local/bin/hypervisor --module <bin> --no-gpu --timeout 5

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
DIM='\033[2m'
RESET='\033[0m'

pass() { printf "${GREEN}pass${RESET}  %s\n" "$1"; }
fail() { printf "${RED}FAIL${RESET}  %s\n" "$1"; }
info() { printf "${DIM}info${RESET}  %s\n" "$1"; }

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
TEST_DIR="$PROJECT_DIR/tests/userspace"
KERNEL="$PROJECT_DIR/target/aarch64-unknown-none/debug/kernel"
HYPERVISOR="$HOME/.local/bin/hypervisor"
CLANG="/usr/bin/clang"
LLD="$HOME/.cargo/bin/rust-lld"
TIMEOUT=5

# ── Preflight checks ────────────────────────────────────────────────

if [ ! -x "$HYPERVISOR" ]; then
    echo "error: hypervisor not found at $HYPERVISOR" >&2
    exit 1
fi

if [ ! -x "$CLANG" ]; then
    echo "error: clang not found at $CLANG" >&2
    exit 1
fi

if [ ! -x "$LLD" ]; then
    echo "error: rust-lld not found at $LLD" >&2
    exit 1
fi

if [ ! -d "$TEST_DIR" ]; then
    info "no test directory at $TEST_DIR"
    exit 0
fi

# Collect test files.
TEST_FILES=("$TEST_DIR"/*.S)

if [ ! -e "${TEST_FILES[0]}" ]; then
    info "no .S files in $TEST_DIR"
    exit 0
fi

# ── Build kernel ─────────────────────────────────────────────────────

info "building kernel"

if ! cargo build 2>/dev/null; then
    echo "error: kernel build failed" >&2
    exit 1
fi

info "kernel built: $KERNEL"

# ── Run tests ────────────────────────────────────────────────────────

PASS_COUNT=0
FAIL_COUNT=0
TOTAL=0
TMPDIR=$(mktemp -d)

trap 'rm -rf "$TMPDIR"' EXIT

for test_file in "${TEST_FILES[@]}"; do
    test_name="$(basename "$test_file" .S)"
    TOTAL=$((TOTAL + 1))
    obj="$TMPDIR/${test_name}.o"
    bin="$TMPDIR/${test_name}.bin"

    # Determine expected outcome from naming convention.
    if [[ "$test_name" == fail_* ]]; then
        expect_pass=false
    else
        expect_pass=true
    fi

    # Assemble.
    if ! "$CLANG" --target=aarch64-unknown-none -c "$test_file" -o "$obj" 2>"$TMPDIR/asm_err"; then
        fail "$test_name (assemble error)"
        cat "$TMPDIR/asm_err" >&2
        FAIL_COUNT=$((FAIL_COUNT + 1))
        continue
    fi

    # Link to flat binary.
    if ! "$LLD" -flavor gnu --oformat binary -Ttext=0 --image-base=0 -o "$bin" "$obj" 2>"$TMPDIR/link_err"; then
        fail "$test_name (link error)"
        cat "$TMPDIR/link_err" >&2
        FAIL_COUNT=$((FAIL_COUNT + 1))
        continue
    fi

    # Run on the kernel via hypervisor. Capture both output and exit code.
    hv_exit=0
    output=$("$HYPERVISOR" "$KERNEL" --module "$bin" --no-gpu --timeout "$TIMEOUT" 2>&1) || hv_exit=$?

    # Parse serial output for result markers.
    has_test_passed=false
    has_fatal_fault=false
    has_panic=false

    if echo "$output" | grep -q "TEST PASSED"; then
        has_test_passed=true
    fi
    if echo "$output" | grep -q "FATAL FAULT"; then
        has_fatal_fault=true
    fi
    if echo "$output" | grep -q "^panic:"; then
        has_panic=true
    fi

    # Evaluate result against expectation.
    if $expect_pass; then
        if $has_test_passed; then
            pass "$test_name"
            PASS_COUNT=$((PASS_COUNT + 1))
        elif $has_fatal_fault; then
            fail "$test_name (got FATAL FAULT, expected TEST PASSED)"
            FAIL_COUNT=$((FAIL_COUNT + 1))
        elif $has_panic; then
            fail "$test_name (kernel panic)"
            FAIL_COUNT=$((FAIL_COUNT + 1))
        elif [ "$hv_exit" -eq 2 ]; then
            fail "$test_name (timeout)"
            FAIL_COUNT=$((FAIL_COUNT + 1))
        else
            fail "$test_name (no result marker in output)"
            FAIL_COUNT=$((FAIL_COUNT + 1))
        fi
    else
        # Expected failure: FATAL FAULT is the expected outcome.
        if $has_fatal_fault; then
            pass "$test_name (expected failure)"
            PASS_COUNT=$((PASS_COUNT + 1))
        elif $has_test_passed; then
            fail "$test_name (got TEST PASSED, expected FATAL FAULT)"
            FAIL_COUNT=$((FAIL_COUNT + 1))
        elif $has_panic; then
            fail "$test_name (kernel panic, expected clean FATAL FAULT)"
            FAIL_COUNT=$((FAIL_COUNT + 1))
        elif [ "$hv_exit" -eq 2 ]; then
            fail "$test_name (timeout, expected FATAL FAULT)"
            FAIL_COUNT=$((FAIL_COUNT + 1))
        else
            fail "$test_name (no result marker in output)"
            FAIL_COUNT=$((FAIL_COUNT + 1))
        fi
    fi
done

# ── Summary ──────────────────────────────────────────────────────────

echo ""
if [ "$FAIL_COUNT" -eq 0 ]; then
    printf "${GREEN}all %d userspace tests passed${RESET}\n" "$TOTAL"
else
    printf "${RED}%d of %d userspace tests failed${RESET}\n" "$FAIL_COUNT" "$TOTAL"
    exit 1
fi
