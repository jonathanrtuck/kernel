#!/bin/bash
# Run benchmark binaries and collect results.
#
# Builds the kernel and all bench_*.rs binaries, runs each under the
# hypervisor, collects BENCH lines from serial output, and formats a
# results table with human-readable time units.
#
# ── Benchmark protocol ──────────────────────────────────────────────
#
# BRK #0x48 emits a data point: kernel prints
#   BENCH <x0> <x1> <x2> <x3>  (16-char zero-padded hex)
# then advances PC and resumes the Observer.
#
# Stats::emit produces 5 consecutive BENCH lines per group:
#   tag+0=min, tag+1=median, tag+2=p99, tag+3=mean, tag+4=count.
# The script detects these groups and formats them as summary lines.

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

info() { printf "${DIM}info${RESET}  %s\n" "$1"; }

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
TEST_DIR="$PROJECT_DIR/tests"
KERNEL="$PROJECT_DIR/target/aarch64-unknown-none/debug/kernel"
HYPERVISOR="$HOME/.local/bin/hypervisor"
LLVM_OBJCOPY="$(find "$(rustc --print sysroot)/lib/rustlib" -name 'llvm-objcopy' 2>/dev/null | head -1)"
TIMEOUT=30

# ── Counter frequency ─────────────────────────────────────────────

FREQ=$(sysctl -n hw.tbfrequency 2>/dev/null || echo 24000000)

ticks_to_time() {
    local ticks=$1
    local ns=$(( ticks * 1000000000 / FREQ ))

    if [ "$ns" -ge 1000000000 ]; then
        # >= 1s: show as seconds with 3 decimal places
        local s=$((ns / 1000000000))
        local ms=$(( (ns / 1000000) % 1000 ))
        printf "%d.%03ds" "$s" "$ms"
    elif [ "$ns" -ge 1000000 ]; then
        # >= 1ms: show as milliseconds with 2 decimal places
        local ms=$((ns / 1000000))
        local us=$(( (ns / 1000) % 1000 ))
        printf "%d.%02dms" "$ms" "$((us / 10))"
    elif [ "$ns" -ge 1000 ]; then
        # >= 1µs: show as microseconds with 2 decimal places
        local us=$((ns / 1000))
        local frac=$((ns % 1000))
        printf "%d.%02dµs" "$us" "$((frac / 10))"
    else
        printf "%dns" "$ns"
    fi
}

# ── Preflight checks ──────────────────────────────────────────────

if [ ! -x "$HYPERVISOR" ]; then
    echo "error: hypervisor not found at $HYPERVISOR" >&2
    exit 1
fi

if [ -z "$LLVM_OBJCOPY" ] || [ ! -x "$LLVM_OBJCOPY" ]; then
    echo "error: llvm-objcopy not found in rustc sysroot" >&2
    exit 1
fi

# ── Build ──────────────────────────────────────────────────────────

info "building kernel"
if ! cargo build 2>/dev/null; then
    echo "error: kernel build failed" >&2
    exit 1
fi

info "building bench binaries"
if ! cargo build --manifest-path "$TEST_DIR/Cargo.toml" 2>/dev/null; then
    echo "error: bench build failed" >&2
    exit 1
fi

# ── Run benchmarks ─────────────────────────────────────────────────

RUST_TARGET="$TEST_DIR/target/aarch64-unknown-none/debug"
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

BENCH_COUNT=0
ERROR_COUNT=0

echo ""
info "counter frequency: $(printf "%'d" $FREQ) Hz ($(( FREQ / 1000000 )) MHz, 1 tick = $((1000000000 / FREQ))ns)"
echo ""
printf "${BOLD}%-35s  %s${RESET}\n" "benchmark" "results"
printf "%-35s  %s\n" "-----------------------------------" "-------"

for elf in "$RUST_TARGET"/bench_*; do
    [ -f "$elf" ] || continue
    file "$elf" 2>/dev/null | grep -q "ELF" || continue

    name="$(basename "$elf")"
    bin="$TMPDIR/${name}.bin"

    if ! "$LLVM_OBJCOPY" -O binary "$elf" "$bin" 2>/dev/null; then
        printf "%-35s  ${RED}SKIP${RESET} (objcopy failed)\n" "$name"
        ERROR_COUNT=$((ERROR_COUNT + 1))
        continue
    fi

    BENCH_COUNT=$((BENCH_COUNT + 1))

    output=$("$HYPERVISOR" "$KERNEL" --module "$bin" --no-gpu --timeout "$TIMEOUT" 2>&1) || true

    # Check for clean exit
    if ! echo "$output" | grep -q "TEST PASSED"; then
        # Show the failure reason
        fault=$(echo "$output" | grep -m1 "FATAL FAULT" || true)
        timeout=$(echo "$output" | grep -m1 "timeout" || true)
        if [ -n "$fault" ]; then
            printf "%-35s  ${RED}ERROR${RESET} (%s)\n" "$name" "$fault"
        elif [ -n "$timeout" ]; then
            printf "%-35s  ${RED}ERROR${RESET} (timeout)\n" "$name"
        else
            printf "%-35s  ${RED}ERROR${RESET} (no TEST PASSED)\n" "$name"
        fi
        ERROR_COUNT=$((ERROR_COUNT + 1))
        continue
    fi

    # Extract BENCH lines
    bench_lines=$(echo "$output" | grep 'BENCH ' | sed 's/^[[:space:]]*//' || true)

    if [ -z "$bench_lines" ]; then
        printf "%-35s  ${DIM}(no BENCH data)${RESET}\n" "$name"
        continue
    fi

    # Collect all tag/value pairs into arrays for Stats group detection.
    # Format: "BENCH <tag_hex_16> <val_hex_16> <m0_hex_16> <m1_hex_16>"
    tags=()
    values=()
    while IFS= read -r line; do
        # Parse the 4 hex fields after "BENCH"
        read -r _ t v m0 m1 <<< "$line"
        tags+=("$t")
        values+=("$v")
    done <<< "$bench_lines"

    n=${#tags[@]}

    # Try to detect Stats::emit groups (5 consecutive tags: base, base+1, ..., base+4)
    # If the lines form complete groups, display summary format.
    i=0
    displayed=false

    while [ $i -lt $n ]; do
        remaining=$((n - i))

        if [ $remaining -ge 5 ]; then
            # Check if these 5 form a Stats group (consecutive tags)
            base_tag=$((16#${tags[$i]}))
            is_group=true

            for offset in 1 2 3 4; do
                idx=$((i + offset))
                expected_tag=$((base_tag + offset))
                actual_tag=$((16#${tags[$idx]}))

                if [ "$actual_tag" -ne "$expected_tag" ]; then
                    is_group=false
                    break
                fi
            done

            if $is_group; then
                min_val=$((16#${values[$i]}))
                median_val=$((16#${values[$((i+1))]}))
                p99_val=$((16#${values[$((i+2))]}))
                mean_val=$((16#${values[$((i+3))]}))
                count_val=$((16#${values[$((i+4))]}))

                min_t=$(ticks_to_time "$min_val")
                med_t=$(ticks_to_time "$median_val")
                p99_t=$(ticks_to_time "$p99_val")
                avg_t=$(ticks_to_time "$mean_val")

                if ! $displayed; then
                    printf "%-35s  " "$name"
                else
                    printf "%-35s  " ""
                fi

                printf "min=%-10s  med=%-10s  p99=%-10s  avg=%-10s  (%d iters)\n" \
                    "$min_t" "$med_t" "$p99_t" "$avg_t" "$count_val"

                displayed=true
                i=$((i + 5))
                continue
            fi
        fi

        # Not part of a Stats group — display raw
        tag_dec=$((16#${tags[$i]}))
        val_dec=$((16#${values[$i]}))
        val_t=$(ticks_to_time "$val_dec")

        if ! $displayed; then
            printf "%-35s  " "$name"
        else
            printf "%-35s  " ""
        fi

        printf "tag=0x%x  value=%d (%s)\n" "$tag_dec" "$val_dec" "$val_t"

        displayed=true
        i=$((i + 1))
    done
done

# ── Summary ────────────────────────────────────────────────────────

echo ""
if [ "$BENCH_COUNT" -eq 0 ]; then
    printf "${DIM}no bench_* binaries found${RESET}\n"
elif [ "$ERROR_COUNT" -gt 0 ]; then
    printf "${RED}%d of %d benchmarks had errors${RESET}\n" "$ERROR_COUNT" "$BENCH_COUNT"
    exit 1
else
    printf "${GREEN}%d benchmark(s) completed${RESET}\n" "$BENCH_COUNT"
fi
