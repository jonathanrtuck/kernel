#!/bin/bash
# Run benchmark binaries and collect results.
#
# Usage:
#   scripts/bench                    Run benchmarks (3 trials, best-of-3)
#   scripts/bench --trials 1         Single trial (fast, noisier)
#   scripts/bench --save FILE        Save results for future comparison
#   scripts/bench --compare FILE     Compare against a saved baseline
#   scripts/bench --save F --compare F  Update baseline and show delta
#
# ── Benchmark protocol ──────────────────────────────────────────────
#
# BRK #0x48 emits a data point: kernel prints
#   BENCH <x0> <x1> <x2> <x3>  (16-char zero-padded hex)
# then advances PC and resumes the Observer.
#
# Stats::emit produces 7 consecutive BENCH lines per group:
#   tag+0=min, tag+1=median, tag+2=p99, tag+3=trimmed_mean,
#   tag+4=iqr, tag+5=mean, tag+6=count.
#
# Multiple trials: each benchmark runs TRIALS times. For stats groups,
# the trial with the lowest median is selected (least host interference).
# For raw values, the minimum is taken.

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

info() { printf "${DIM}info${RESET}  %s\n" "$1"; }

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
TEST_DIR="$PROJECT_DIR/tests"
KERNEL="$PROJECT_DIR/target/aarch64-unknown-none/debug/kernel"
HYPERVISOR="$HOME/.local/bin/hypervisor"
LLVM_OBJCOPY="$(find "$(rustc --print sysroot)/lib/rustlib" -name 'llvm-objcopy' 2>/dev/null | head -1)"
TIMEOUT=30
TRIALS=3
SAVE_FILE=""
COMPARE_FILE=""

# ── Argument parsing ──────────────────────────────────────────────

while [ $# -gt 0 ]; do
    case "$1" in
        --trials)  TRIALS="$2"; shift 2 ;;
        --save)    SAVE_FILE="$2"; shift 2 ;;
        --compare) COMPARE_FILE="$2"; shift 2 ;;
        -h|--help)
            sed -n '2,/^$/{ s/^# //; s/^#//; p }' "$0"
            exit 0
            ;;
        *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
done

# ── Counter frequency ─────────────────────────────────────────────

FREQ=$(sysctl -n hw.tbfrequency 2>/dev/null || echo 24000000)

ticks_to_time() {
    local ticks=$1
    local ns=$(( ticks * 1000000000 / FREQ ))

    if [ "$ns" -ge 1000000000 ]; then
        local s=$((ns / 1000000000))
        local ms=$(( (ns / 1000000) % 1000 ))
        printf "%d.%03ds" "$s" "$ms"
    elif [ "$ns" -ge 1000000 ]; then
        local ms=$((ns / 1000000))
        local us=$(( (ns / 1000) % 1000 ))
        printf "%d.%02dms" "$ms" "$((us / 10))"
    elif [ "$ns" -ge 1000 ]; then
        local us=$((ns / 1000))
        local frac=$((ns % 1000))
        printf "%d.%02dµs" "$us" "$((frac / 10))"
    else
        printf "%dns" "$ns"
    fi
}

# Right-pad a string to a target display width.
# printf's %-Ns counts bytes, not display columns — the multi-byte µ (U+00B5)
# in µs values causes columns to fall 1 short. This pads by character count.
pad() {
    local str="$1" width="$2"
    printf "%s" "$str"
    local len=${#str}
    local spaces=$((width - len))
    [ "$spaces" -gt 0 ] && printf "%${spaces}s" ""
}

# Format a percentage delta: (+12%), (-3%), (=)
format_delta() {
    local old=$1 new=$2
    if [ "$old" -eq 0 ]; then
        printf "(new)"
        return
    fi
    local pct=$(( (new - old) * 100 / old ))
    if [ "$pct" -gt 10 ]; then
        printf "${RED}(+%d%%)${RESET}" "$pct"
    elif [ "$pct" -gt 2 ]; then
        printf "${YELLOW}(+%d%%)${RESET}" "$pct"
    elif [ "$pct" -lt -2 ]; then
        printf "${GREEN}(%d%%)${RESET}" "$pct"
    else
        printf "(=)"
    fi
}

# ── Baseline loading ──────────────────────────────────────────────

# Baseline file is tab-separated: name\ttype\tidx\tfield\tvalue
# Lookup via grep (no associative arrays — macOS ships bash 3.2).
BASELINE_LOADED=""

baseline_lookup() {
    local name="$1" idx="$2" field="$3"
    [ -n "$BASELINE_LOADED" ] || return 1
    local line
    line=$(grep -m1 "^${name}	[a-z]*	${idx}	${field}	" "$BASELINE_LOADED" 2>/dev/null) || return 1
    echo "$line" | cut -f5
}

if [ -n "$COMPARE_FILE" ]; then
    if [ ! -f "$COMPARE_FILE" ]; then
        echo "warning: baseline file not found: $COMPARE_FILE (running without comparison)" >&2
    else
        BASELINE_LOADED="$COMPARE_FILE"
        info "loaded baseline from $COMPARE_FILE"
    fi
fi

# ── Preflight checks ──────────────────────────────────────────────

if [ ! -x "$HYPERVISOR" ]; then
    echo "error: hypervisor not found at $HYPERVISOR" >&2
    exit 1
fi

if [ -z "$LLVM_OBJCOPY" ] || [ ! -x "$LLVM_OBJCOPY" ]; then
    echo "error: llvm-objcopy not found in rustc sysroot" >&2
    exit 1
fi

# ── Build ──────────────────────────────────────────────────────────

info "building kernel"
if ! cargo build 2>/dev/null; then
    echo "error: kernel build failed" >&2
    exit 1
fi

info "building bench binaries"
if ! cargo build --manifest-path "$TEST_DIR/Cargo.toml" 2>/dev/null; then
    echo "error: bench build failed" >&2
    exit 1
fi

# ── Run benchmarks ─────────────────────────────────────────────────

RUST_TARGET="$TEST_DIR/target/aarch64-unknown-none/debug"
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT
mkdir -p "$TMPDIR/results"

BENCH_COUNT=0
ERROR_COUNT=0

# Save file header
SAVE_LINES=()
SAVE_LINES+=("# bench results $(date -u +%Y-%m-%dT%H:%M:%SZ)")
SAVE_LINES+=("# freq=$FREQ trials=$TRIALS")

echo ""
info "counter frequency: $(printf "%'d" $FREQ) Hz ($(( FREQ / 1000000 )) MHz, 1 tick = $((1000000000 / FREQ))ns)"
if [ "$TRIALS" -gt 1 ]; then
    info "running $TRIALS trials per benchmark (best-of-$TRIALS)"
fi
echo ""
printf "${BOLD}%-35s  %s${RESET}\n" "benchmark" "results"
printf "%-35s  %s\n" "-----------------------------------" "-------"

for elf in "$RUST_TARGET"/bench_*; do
    [ -f "$elf" ] || continue
    file "$elf" 2>/dev/null | grep -q "ELF" || continue

    name="$(basename "$elf")"
    bin="$TMPDIR/${name}.bin"

    if ! "$LLVM_OBJCOPY" -O binary "$elf" "$bin" 2>/dev/null; then
        printf "%-35s  ${RED}SKIP${RESET} (objcopy failed)\n" "$name"
        ERROR_COUNT=$((ERROR_COUNT + 1))
        continue
    fi

    BENCH_COUNT=$((BENCH_COUNT + 1))

    # ── Run multiple trials ────────────────────────────────────
    best_trial_file=""
    best_median=999999999999

    for trial in $(seq 1 "$TRIALS"); do
        output=$("$HYPERVISOR" "$KERNEL" --module "$bin" --no-gpu --timeout "$TIMEOUT" 2>&1) || true

        if ! echo "$output" | grep -q "TEST PASSED"; then
            continue
        fi

        bench_lines=$(echo "$output" | grep 'BENCH ' | sed 's/^[[:space:]]*//' || true)
        [ -z "$bench_lines" ] && continue

        trial_file="$TMPDIR/trial_${name}_${trial}"
        echo "$bench_lines" > "$trial_file"

        # Find the first stats group's median (tag+1) to rank this trial
        trial_tags=()
        trial_values=()
        while IFS= read -r line; do
            read -r _ t v m0 m1 <<< "$line"
            trial_tags+=("$t")
            trial_values+=("$v")
        done <<< "$bench_lines"

        # Check for a 7-value group to get the median
        if [ ${#trial_tags[@]} -ge 7 ]; then
            base=$((16#${trial_tags[0]}))
            next=$((16#${trial_tags[1]}))
            if [ "$next" -eq $((base + 1)) ]; then
                this_median=$((16#${trial_values[1]}))
                if [ "$this_median" -lt "$best_median" ]; then
                    best_median=$this_median
                    best_trial_file="$trial_file"
                fi
                continue
            fi
        fi

        # No stats group — just keep the last successful trial
        best_trial_file="$trial_file"
    done

    if [ -z "$best_trial_file" ]; then
        fault=$(echo "$output" | grep -m1 "FATAL FAULT" || true)
        timeout_msg=$(echo "$output" | grep -m1 "timeout after" || true)
        if [ -n "$fault" ]; then
            printf "%-35s  ${RED}ERROR${RESET} (%s)\n" "$name" "$fault"
        elif [ -n "$timeout_msg" ]; then
            printf "%-35s  ${RED}ERROR${RESET} (timeout)\n" "$name"
        else
            printf "%-35s  ${RED}ERROR${RESET} (no TEST PASSED)\n" "$name"
        fi
        ERROR_COUNT=$((ERROR_COUNT + 1))
        continue
    fi

    # ── Parse best trial ───────────────────────────────────────

    tags=()
    values=()
    while IFS= read -r line; do
        read -r _ t v m0 m1 <<< "$line"
        tags+=("$t")
        values+=("$v")
    done < "$best_trial_file"

    n=${#tags[@]}
    i=0
    displayed=false
    group_idx=0

    while [ $i -lt $n ]; do
        remaining=$((n - i))

        # Try 7-value group (min, median, p99, trimmed_mean, iqr, mean, count)
        if [ $remaining -ge 7 ]; then
            base_tag=$((16#${tags[$i]}))
            is_group=true

            for offset in 1 2 3 4 5 6; do
                idx=$((i + offset))
                expected_tag=$((base_tag + offset))
                actual_tag=$((16#${tags[$idx]}))

                if [ "$actual_tag" -ne "$expected_tag" ]; then
                    is_group=false
                    break
                fi
            done

            if $is_group; then
                min_val=$((16#${values[$i]}))
                median_val=$((16#${values[$((i+1))]}))
                p99_val=$((16#${values[$((i+2))]}))
                tavg_val=$((16#${values[$((i+3))]}))
                iqr_val=$((16#${values[$((i+4))]}))
                mean_val=$((16#${values[$((i+5))]}))
                count_val=$((16#${values[$((i+6))]}))

                min_t=$(ticks_to_time "$min_val")
                med_t=$(ticks_to_time "$median_val")
                p99_t=$(ticks_to_time "$p99_val")
                tavg_t=$(ticks_to_time "$tavg_val")
                iqr_t=$(ticks_to_time "$iqr_val")

                # Baseline comparison for median
                med_delta=""
                old_med=$(baseline_lookup "$name" "$group_idx" "med" 2>/dev/null) && \
                    med_delta=" $(format_delta "$old_med" "$median_val")"

                if ! $displayed; then
                    printf "%-35s  " "$name"
                else
                    printf "%-35s  " ""
                fi

                printf "min=%s  med=%s%s  p99=%s  tavg=%s  iqr=%s  (%d iters)\n" \
                    "$(pad "$min_t" 10)" "$(pad "$med_t" 10)" "${med_delta:- }" \
                    "$(pad "$p99_t" 10)" "$(pad "$tavg_t" 9)" "$(pad "$iqr_t" 9)" "$count_val"

                # Save results
                SAVE_LINES+=("${name}	stats	${group_idx}	min	${min_val}")
                SAVE_LINES+=("${name}	stats	${group_idx}	med	${median_val}")
                SAVE_LINES+=("${name}	stats	${group_idx}	p99	${p99_val}")
                SAVE_LINES+=("${name}	stats	${group_idx}	tavg	${tavg_val}")
                SAVE_LINES+=("${name}	stats	${group_idx}	iqr	${iqr_val}")
                SAVE_LINES+=("${name}	stats	${group_idx}	mean	${mean_val}")
                SAVE_LINES+=("${name}	stats	${group_idx}	count	${count_val}")

                displayed=true
                group_idx=$((group_idx + 1))
                i=$((i + 7))
                continue
            fi
        fi

        # Fall back to 5-value group (legacy format)
        if [ $remaining -ge 5 ]; then
            base_tag=$((16#${tags[$i]}))
            is_group=true

            for offset in 1 2 3 4; do
                idx=$((i + offset))
                expected_tag=$((base_tag + offset))
                actual_tag=$((16#${tags[$idx]}))

                if [ "$actual_tag" -ne "$expected_tag" ]; then
                    is_group=false
                    break
                fi
            done

            if $is_group; then
                min_val=$((16#${values[$i]}))
                median_val=$((16#${values[$((i+1))]}))
                p99_val=$((16#${values[$((i+2))]}))
                mean_val=$((16#${values[$((i+3))]}))
                count_val=$((16#${values[$((i+4))]}))

                min_t=$(ticks_to_time "$min_val")
                med_t=$(ticks_to_time "$median_val")
                p99_t=$(ticks_to_time "$p99_val")
                avg_t=$(ticks_to_time "$mean_val")

                med_delta=""
                bmed=$(baseline_lookup "$name" "$group_idx" "med" 2>/dev/null) && \
                    med_delta=" $(format_delta "$bmed" "$median_val")"

                if ! $displayed; then
                    printf "%-35s  " "$name"
                else
                    printf "%-35s  " ""
                fi

                printf "min=%s  med=%s%s  p99=%s  avg=%s  (%d iters)\n" \
                    "$(pad "$min_t" 10)" "$(pad "$med_t" 10)" "${med_delta:- }" \
                    "$(pad "$p99_t" 10)" "$(pad "$avg_t" 10)" "$count_val"

                SAVE_LINES+=("${name}	stats	${group_idx}	min	${min_val}")
                SAVE_LINES+=("${name}	stats	${group_idx}	med	${median_val}")
                SAVE_LINES+=("${name}	stats	${group_idx}	p99	${p99_val}")
                SAVE_LINES+=("${name}	stats	${group_idx}	mean	${mean_val}")
                SAVE_LINES+=("${name}	stats	${group_idx}	count	${count_val}")

                displayed=true
                group_idx=$((group_idx + 1))
                i=$((i + 5))
                continue
            fi
        fi

        # Not part of a Stats group — display raw
        tag_dec=$((16#${tags[$i]}))
        val_dec=$((16#${values[$i]}))
        val_t=$(ticks_to_time "$val_dec")

        val_delta=""
        old_val=$(baseline_lookup "$name" "$group_idx" "tag_${tag_dec}" 2>/dev/null) && \
            val_delta=" $(format_delta "$old_val" "$val_dec")"

        if ! $displayed; then
            printf "%-35s  " "$name"
        else
            printf "%-35s  " ""
        fi

        printf "tag=0x%x  value=%d (%s)%s\n" "$tag_dec" "$val_dec" "$val_t" "$val_delta"

        SAVE_LINES+=("${name}	raw	${group_idx}	tag_${tag_dec}	${val_dec}")

        displayed=true
        group_idx=$((group_idx + 1))
        i=$((i + 1))
    done
done

# ── Save results ──────────────────────────────────────────────────

if [ -n "$SAVE_FILE" ]; then
    printf '%s\n' "${SAVE_LINES[@]}" > "$SAVE_FILE"
    info "results saved to $SAVE_FILE"
fi

# ── Summary ────────────────────────────────────────────────────────

echo ""
if [ "$BENCH_COUNT" -eq 0 ]; then
    printf "${DIM}no bench_* binaries found${RESET}\n"
elif [ "$ERROR_COUNT" -gt 0 ]; then
    printf "${RED}%d of %d benchmarks had errors${RESET}\n" "$ERROR_COUNT" "$BENCH_COUNT"
    exit 1
else
    printf "${GREEN}%d benchmark(s) completed${RESET}\n" "$BENCH_COUNT"
fi
