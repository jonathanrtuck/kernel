{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/rustfmt-post-edit.sh",
            "statusMessage": "rustfmt…",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "node .explore/trigger.js",
            "disabled": true,
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/load-design-context.py",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
