userspace: {
  shape: person
}

kernel: {
  core-manager: {
    label: Core manager
    style.multiple: true

    syscall: {
      shape: class
    }

    time-manager: {
      label: Time manager

      interface: {
        shape: class

        pick()
      }
    }

    contexts: {
      label: Contexts
      style.multiple: true
    }

    ipi: {
      label: IPI
      shape: class
    }

    time-manager -> contexts: reads
  }

  contexts: {
    label: Contexts
    style.multiple: true

    model: {
      shape: class

      register state
      TTBR
      runnable / blocked
      current_core
      fault handler cap
      pending message
      scheduling hints
    }
  }

  capabilities: {
    label: Capabilities

    model: {
      shape: class
    }
  }

  space-manager: {
    label: Space manager

    interface: {
      shape: class

      resolve_fault()
      map()
      unmap()
      create_space()
      destroy_space()
      share()
    }

    allocator: {
      label: allocator

      interface: {
        shape: class

        request()
        release()
      }
    }
  }

  core-manager -> core-manager.ipi: sends
  core-manager -> contexts.model: reads/writes
  core-manager -> capabilities: resolves
  core-manager -> space-manager.interface: on fault
  core-manager.time-manager -> contexts.model: reads
  space-manager -> contexts.model: writes TTBR
  core-manager.contexts -> contexts: indexes into {
    style.stroke-dash: 3
  }
}

hardware: {
  shape: parallelogram

  memory
  core: {
    style.multiple: true
  }
}

kernel -> userspace: fault delivery, messages
userspace -> kernel.core-manager.syscall: invokes
hardware.core -> kernel.core-manager: all exceptions (incl. SGI)
kernel.space-manager.allocator -> hardware.memory
kernel.core-manager.time-manager -> hardware.core: programs timer
