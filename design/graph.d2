userspace: {
  shape: person
}

kernel: {
  shape: rectangle

  syscall: {
    shape: class
  }

  reactor: {
    shape: oval
  }

  space-manager: {
    label: Space manager

    interface: {
      shape: class

      resolve_fault()
      map()
      unmap()
      create_space()
      destroy_space()
      share()
    }

    allocator: {
      label: allocator

      interface: {
        shape: class

        request()
        release()
      }
    }
  }

  scheduler: {
    label: Time manager (Scheduler)

    interface: {
      shape: class

      pick()
    }

    allocator: {
      label: allocator

      interface: {
        shape: class
      }
    }
  }

  contexts: {
    label: Contexts
    style.multiple: true

    model: {
      shape: class

      register state
      TTBR
      runnable / blocked
      fault handler cap
      pending message
    }
  }

  reactor -> space-manager.interface
  reactor -> scheduler.interface
  reactor -> contexts: writes
  scheduler -> contexts: reads
  space-manager -> contexts: writes TTBR
}

hardware: {
  shape: parallelogram

  memory
  cores: {
    style.multiple: true
  }
}

kernel -> userspace: fault delivery
userspace -> kernel.syscall: invokes
hardware -> kernel.reactor: all exceptions (incl. SVC)
kernel.space-manager.allocator -> hardware.memory
kernel.scheduler.allocator -> hardware.cores
