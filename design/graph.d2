# Kernel structural map.
#
# Populated from design/spec.md derivations D1-D4, observations O2-O3,
# and Vocabulary (Space, Time, Frame). Every box and edge has a
# corresponding spec.md entry; items labeled "TBD" await downstream
# derivation.
#
# Intentionally absent (pending derivation): syscall surface,
# Frame schema, IPC shape, capability table structure/revocation,
# per-physical-core concerns (power, thermal, shared cache/TLB).
# See spec.md#Open questions.
#
# Render with: d2 --layout elk graph.d2

userspace: {
  shape: person
}

kernel: {
  core-manager: {
    label: Core manager
    style.multiple: true
    # Per logical core (spec.md#D1).
    # Owns the per-core hot path: exception entry, state update,
    # next-Frame selection, resumption.
    #
    # External entry surface (exception vector) is intentionally
    # not drawn as a single interface node — the three sources
    # (userspace syscall, hardware exceptions, cross-core IPI)
    # are heterogeneous and the unifying contract is not yet
    # derived. See spec.md#Open questions.

    time-manager: {
      label: Time manager
      # Per Core manager (spec.md#D2).
      # Scheduling algorithm is a leaf-node, swappable per core.
      # Carries algorithm-specific state; Frame carries only
      # abstract scheduling properties.

      interface: {
        shape: class
        # In: Frame's abstract scheduling properties.
        # Out: next Frame to resume.
        # D2: algorithm-specific state stays inside.
      }
    }
  }

  space-manager: {
    label: Space manager
    # Single logical interface (spec.md#D3).
    # Internal strategy (partitioning, NUMA-awareness, per-core
    # caches, cross-node fallback) is a leaf-node concern below
    # this layer and intentionally not represented here.

    interface: {
      shape: class
    }
  }

  frame: {
    label: Frame
    style.multiple: true
    # Vocabulary: coupled Space(s) + exactly one Time.
    # Internal schema TBD (spec.md#Open questions).

    capabilities: {
      label: Capability table
      # Per-Frame, per-core accessible (D4 + D1).
      # Each entry: (kernel object ref, rights mask).
      # Table structure (flat/CNode/etc.) TBD.
    }
  }
}

hardware: {
  shape: parallelogram

  memory
  core: {
    style.multiple: true
    # Logical core. Per-physical-core concerns (power, thermal,
    # shared L1/TLB on SMT) belong to components not yet derived.
  }
}

# Cross-core coordination (O2): IPIs are the only wake mechanism
# because A4 means there is no kernel thread to poll.
kernel.core-manager -> kernel.core-manager: IPI

# Hardware -> kernel (A2, O3)
hardware.core -> kernel.core-manager: exceptions (incl. SGI)

# Kernel -> hardware
kernel.core-manager.time-manager -> hardware.core: timer programming
kernel.space-manager -> hardware.memory

# D4: Core manager resolves capabilities from the running Frame's
# table during syscall handling (hot path, per-core).
kernel.core-manager -> kernel.frame.capabilities: resolve (hot path)

# Capabilities designate kernel objects (Space, Time, etc.).
# The capability table connects Frames to the resources they
# are authorized to use.
kernel.frame.capabilities -> kernel.space-manager: Space capabilities
kernel.frame.capabilities -> kernel.core-manager.time-manager: Time capabilities

# External interface: the userspace-facing shape is still TBD.
# userspace -> kernel is a capability-mediated invocation producing
# some combination of O1's three output types.
userspace -> kernel.core-manager: syscall (capability-mediated, D4)
kernel -> userspace: fault delivery, messages (shape TBD)
