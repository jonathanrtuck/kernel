# Kernel structural map.
#
# This file is intentionally sparse. It was reset on 2026-04-15 alongside
# spec.md to re-derive contingent decisions from first principles. Only the
# axiomatic outer topology remains: the three actors (userspace, kernel,
# hardware) and the edges that are forced by the axioms (exceptions enter the
# kernel; the kernel delivers to userspace; userspace invokes the kernel
# through a defined interface).
#
# Internal kernel structure is intentionally absent. It will be populated as
# the derivation identifies components and the interfaces between them.
#
# Render with: d2 --layout elk graph.d2

userspace: {
  shape: person
}

kernel: {
  # Internals TBD. The derivation will populate this box as components are
  # identified and stress-tested.
}

hardware: {
  shape: parallelogram

  memory
  core: {
    style.multiple: true
  }
}

kernel -> userspace: fault delivery, messages
userspace -> kernel: invokes (interface TBD)
hardware.core -> kernel: all exceptions
