# Kernel structural map.
#
# Populated from design/spec.md derivations D1-D6, D8-D26, observations O2-O3,
# and Vocabulary (Space, Time, Observer). Every box and edge has a corresponding
# spec.md entry; items labeled "TBD" await downstream derivation.
#
# Intentionally absent (pending derivation): specific syscall surface, Observer
# minimum schema, Observer creation API and rights model (D14 downstream),
# endpoint details (multi-wait, message format — D13/D15 downstream; overflow
# settled by D18), revocation add-ons (generation, CDT — base settled in D11;
# badges settled in D17), per-physical-core concerns (power, thermal, shared
# cache/TLB). See spec.md#Open questions.
#
# Render with: d2 --layout elk graph.d2

userspace: {
  shape: person
}

kernel: {
  core-manager: {
    label: Core manager
    style.multiple: true
    # Per logical core (spec.md#D1).
    # Owns the per-core hot path: exception entry, state update,
    # next-Observer selection, resumption.
    #
    # External entry surface (exception vector) is intentionally
    # not drawn as a single interface node — the three sources
    # (userspace syscall, hardware exceptions, cross-core IPI)
    # are heterogeneous and the unifying contract is not yet
    # derived. See spec.md#Open questions.

    time-manager: {
      label: Time manager
      # Per Core manager (spec.md#D2).
      # Scheduling algorithm is a leaf-node, swappable per core.
      # Carries algorithm-specific state; Observer carries only
      # abstract scheduling properties.

      interface: {
        shape: class
        # In: Observer's abstract scheduling properties.
        # Out: next Observer to resume.
        # D2: algorithm-specific state stays inside.
      }
    }
  }

  space-manager: {
    label: Space manager
    # Single logical interface (spec.md#D3).
    # Internal strategy (partitioning, NUMA-awareness, per-core
    # caches, cross-node fallback) is a leaf-node concern below
    # this layer and intentionally not represented here.

    interface: {
      shape: class
    }
  }

  space: {
    label: Space
    style.multiple: true
    # D9: variable-size, kernel-managed memory object.
    # Designated by capabilities. Access via (Space, offset)
    # pairs (D26) — holding the cap is sufficient for access.
    # Each Space has a kernel-assigned VA base (per-Space,
    # same for all holders). Physical backing is kernel-internal.
    # Sharing: multiple Observers hold caps to same Space.
    # D25: page size exposed — minimum Space size = page size.
  }

  observer: {
    label: Observer
    style.multiple: true
    # D6: single schedulable execution unit.
    # D14: capability-held kernel object type (fourth type).
    # Lifecycle operations (resume, destroy, potentially more)
    # are typed kernel syscalls (D7) taking Observer handles.
    # One register state, one Time, one capability table.
    # Accesses Spaces via (cap, offset) — D26.
    # "Process" is a userspace convention (group of Observers
    # sharing Space caps).
    # D20: per-Observer fault handler (endpoint ref + badge).
    # D21: fault handler is a cap-table entry at reserved slot
    # (not a separate Observer struct field). D11/D17/D8 apply.
    # D23: Observer handles are clonable — uniform with all
    # other kernel object types. Rights separation via multiple
    # caps with different masks.
    # Minimum schema, creation API, rights model TBD.

    capabilities: {
      label: Capability table
      # D8: kernel-managed flat array, per-Observer (D4 + D1).
      # Each entry: (kernel object ref, rights mask, badge, slot tag).
      # D17: badge is minter-assigned, immutable, kernel-attached
      # to messages. Rights mask includes send, receive, mint (D17).
      # Handles carry a generational slot tag (D11) — bumped on
      # slot reuse, prevents stale-handle aliasing. ABA defense,
      # not revocation; does not invalidate live capabilities.
      # Backed by typed memory from Observer's budget.
      # O(1) lookup via handle index.
      # Revocation primitive: close-only (refcount on drop) +
      # authoritative destroy (D11). Badge-closure notifications
      # on tracked endpoints (D17).
      # Table sharing: whether Observers sharing Spaces should
      # share cap tables is open (D8 downstream).
    }
  }

  endpoint: {
    label: Endpoint
    style.multiple: true
    # D13: queued endpoints with direct-switch fast path (tentative).
    # D15: unidirectional, many-to-many, send/receive as object-rights.
    # D16: reply via pre-allocated reply endpoint with send-once cap.
    # D17: badge semantics — minter-assigned, mint-right-controlled,
    # opt-in per-badge lifecycle tracking.
    # Single kernel object: bounded queue + waiters list.
    # Optionally: per-badge refcount map (creation-time opt-in, D17).
    # Topology via capability distribution (not kernel-enforced).
    # Rights: send, receive, mint (D17), send-once (D16) —
    # independently grantable through D8 rights mask.
    # All information delivery (IPC, faults, interrupts, badge-closure
    # notifications on tracked endpoints) through the same mechanism.
    # Kernel is a sender for fault/interrupt/closure messages (D12, D17).
    # D22: interrupts are endpoint traffic — no separate IRQ type.
    # Kernel routes hardware IRQs to endpoints, delivers with badge +
    # send-once ack cap (D16). Split/combine for IRQ range delegation.
    # Each Observer has a pre-allocated reply endpoint; Call() creates
    # a send-once cap for RPC reply (D16).
    # D18: overflow = error-to-sender. Deferred fault delivery via
    # per-endpoint pending list (intrusive, through Observer objects).
    # Badge-closure dropped on full queue.
    # Coalescing lives in shared memory, not endpoint (D18 dissolves D13 tension).
    # Multi-wait, message format TBD.
  }

}

hardware: {
  shape: parallelogram

  memory
  gic: {
    label: GIC
    # A2: GICv3 interrupt controller.
    # D22: kernel programs GIC for interrupt masking, EOI, routing.
    # CPU Interface (ICC_* regs) is per-core (D1 hot path).
    # Distributor (GICD_*) is shared (D1 cold path).
  }
  mmu: {
    label: MMU
    # D5: per-core, programs TTBR to current Observer's page tables.
    # Enforces virtual-to-physical translation and memory attributes
    # (cacheability, permissions) on every access.
  }
  core: {
    style.multiple: true
    # Logical core. Per-physical-core concerns (power, thermal,
    # shared L1/TLB on SMT) belong to components not yet derived.
  }
}

# Cross-core coordination (O2): IPIs are the only wake mechanism
# because A4 means there is no kernel thread to poll.
kernel.core-manager -> kernel.core-manager: IPI

# Hardware -> kernel (A2, O3)
hardware.gic -> kernel.core-manager: device interrupts (D22, routed to endpoints)
hardware.core -> kernel.core-manager: exceptions (incl. SGI)

# Kernel -> hardware
kernel.core-manager.time-manager -> hardware.core: timer programming
# D5 + D26: kernel maintains page tables internally (per-Observer L0 root,
# per-Space shared subtrees); MMU enforces them.
kernel.space -> hardware.mmu: page table translation (D5, D26)
hardware.mmu -> hardware.memory: translated access

# D4: Core manager resolves capabilities from the running Observer's
# table during syscall handling (hot path, per-core).
kernel.core-manager -> kernel.observer.capabilities: resolve (hot path)

# D5 + D26: Core manager loads Observer's L0 page table TTBR on context switch
# (hot path). Observers sharing identical Space cap sets could share TTBR.
kernel.core-manager -> hardware.mmu: TTBR load (hot path)

# Capabilities designate kernel objects (Space, Time, Observers, endpoints).
# The capability table connects Observers to the resources they
# are authorized to use. Space caps grant memory access (D26).
kernel.observer.capabilities -> kernel.space: access via (cap, offset) (D4, D9, D26)
kernel.observer.capabilities -> kernel.endpoint: send/receive (D4, D15)
kernel.observer.capabilities -> kernel.observer: lifecycle ops (D4, D14)
# D9: Space manager allocates physical backing for Spaces.
kernel.space-manager -> kernel.space: physical backing
kernel.observer.capabilities -> kernel.core-manager.time-manager: Time capabilities
# D22: Interrupts delivered through endpoints (no separate IRQ type).
# Kernel routes hardware IRQs to endpoints internally.
# Ack via D16 send-once cap in interrupt message.

# External interface: two mechanism families (D7).
# 1. Typed kernel operation syscalls (Observer -> Kernel, always synchronous).
# 2. IPC syscalls (Observer <-> Observer, mechanism TBD).
# Both are capability-mediated (D4). The split reflects the
# trust-model asymmetry: kernel is exception handler (A4),
# not a peer.
userspace -> kernel.core-manager: kernel op syscalls (D7, capability-mediated)
# D13+D15: Queued endpoints, unidirectional, many-to-many.
# Bounded queue, non-blocking send, direct process switch when
# receiver waiting. One mechanism for IPC, faults, interrupts.
# Send/receive rights via D8 capability rights mask.
# D18: error-to-sender on full queue; deferred fault delivery.
# Remaining: multi-wait, message format.
userspace -> userspace: IPC via queued endpoints (D7+D13+D15, capability-mediated)
# D12: All page faults delegated to userspace pager Observers.
# Kernel provides dispatch only (detect, notify, resume).
# Pager Observers handle policy (eviction, prefetch, page source).
# D20: fault handler attaches per-Observer (endpoint ref + badge).
# D14: Resume via resume(observer_handle) typed kernel syscall.
# Observer handle delivered in fault message via cap transfer (D13).
kernel -> userspace: fault delegation (D12+D14+D20, pager notification + resume)
# D22: Device interrupts delegated to userspace driver Observers.
# Kernel dispatches (mask, enqueue to endpoint with badge + send-once ack cap, EOI).
# Driver handles + acks via send-once. No separate IRQ type — all endpoint traffic.
kernel -> userspace: interrupt delegation (D22, via endpoints + D16 send-once ack)
