userspace: {
  shape: person
}

kernel: {
  core-manager: {
    label: Core manager
    style.multiple: true

    syscall: {
      shape: class

      send()
      receive()
      clone()
      close()
      destroy()
    }

    time-manager: {
      label: Time manager

      interface: {
        shape: class

        pick()
        admit()
        release()
      }

      allocator: {
        interface: {
          shape: class

          request()
          release()
        }
      }
    }

    contexts: {
      label: Contexts
      style.multiple: true
    }

    ipi: {
      label: IPI
      shape: class
    }

    time-manager -> contexts: reads
  }

  contexts: {
    label: Contexts
    style.multiple: true

    model: {
      shape: class

      register_state
      ttbr
      state: runnable | blocked | suspended
      fault_handler: (endpoint_ref, badge)
      control_endpoint
      pending_message
    }
  }

  capabilities: {
    space: {
      label: Space
    }

    time: {
      label: Time
    }

    endpoint: {
      label: Endpoint
    }
  }

  space-manager: {
    label: Space manager

    interface: {
      shape: class

      resolve_fault()
      map()
      unmap()
      create_space()
      destroy_space()
      share()
    }

    allocator: {
      interface: {
        shape: class

        request()
        release()
      }
    }
  }

  core-manager -> core-manager.ipi: sends
  core-manager -> contexts.model: reads/writes
  core-manager -> capabilities: resolves
  core-manager -> space-manager.interface: on fault
  core-manager.time-manager -> contexts.model: reads
  space-manager -> contexts.model: writes TTBR
  contexts.model -> capabilities: holds
  core-manager.contexts -> contexts: indexes into {
    style.stroke-dash: 3
  }
}

hardware: {
  shape: parallelogram

  memory
  core: {
    style.multiple: true
  }
}

kernel -> userspace: fault delivery, messages
userspace -> kernel.core-manager.syscall: invokes
hardware.core -> kernel.core-manager: all exceptions (incl. SGI)
kernel.space-manager.allocator -> hardware.memory
kernel.core-manager.time-manager -> hardware.core: programs timer
